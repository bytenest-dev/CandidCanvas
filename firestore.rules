rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@candidcanvas.com' ||
        request.auth.token.email == 'team.candidcanvas.bd@gmail.com' ||
        request.auth.token.email == 'mdhasibulhasan0210@gmail.com'
      );
    }

    // Site settings — public read, admin write only
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings — users create own, admin manages all
    // read restricted to own bookings only (not all authenticated users)
    match /bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Gallery — public read, admin write only
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials — public read, admin write only
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site gallery — admin write only (was open to all auth users — FIXED)
    match /siteGallery/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site slider — admin write only
    match /siteSlider/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site packages — admin write only
    match /sitePackages/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site reviews — admin write only (clients submit to pendingReviews via DashboardPage)
    match /siteReviews/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site data (visitors, analytics, booking counter) — admin write only
    match /siteData/{doc} {
      allow read:  if true;
      allow write: if isAdmin() || (
        // Allow authenticated users to only update the booking counter and visitor counts
        request.auth != null && (
          doc == 'bookingCounterGlobal' ||
          doc == 'visitors' ||
          doc.matches('visitors_.*')
        )
      );
    }

    // Messages — users see only their own; admin sees all; only admin can reply/delete
    match /messages/{doc} {
      allow read:   if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Promo codes — public read for validation, admin write only
    match /promoCodes/{promoId} {
      allow read:  if true;
      allow write: if isAdmin() || (
        // Allow authenticated users to increment usageCount only
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
      );
    }

    // Notifications — users read/manage their own; admin can create for any user
    match /notifications/{docId} {
      allow read:   if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null &&
        (isAdmin() || request.auth.uid == request.resource.data.userId);
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Monthly backups — admin only
    match /monthlyBackups/{month} {
      allow read, write: if isAdmin();
    }

    // Users — admin reads all; users read/write only their own
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow update, delete: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null;
    }

    // Referrals — users read their own; only admin can write
    match /referrals/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
