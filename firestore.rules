rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester the admin account?
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@candidcanvas.com' ||
        request.auth.token.email == 'team.candidcanvas.bd@gmail.com'
      );
    }

    // Site settings — public read, admin write only
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings — users create own, admin manages all
    match /bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Gallery — public read, admin write
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials — public read, admin write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site gallery collection
    match /siteGallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site slider collection
    match /siteSlider/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site packages collection
    match /sitePackages/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site reviews collection
    match /siteReviews/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site data (settings, visitors, analytics)
    match /siteData/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Messages — authenticated users only
    match /messages/{doc} {
      allow read, write: if request.auth != null;
    }

    // Users — admin can read/write ALL user docs; users can read/write own
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      // Admin can update/delete any user; users can only update their own
      allow update, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null;
    }
  }
}
